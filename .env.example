# Transport Victoria Open Data Portal KeyID.
# Copy this file to .env.local and keep the real value private.
TRANSPORT_VIC_API_KEY=

# Okta OIDC web application. Required to access train-line status.
# Local callback URL: http://localhost:3000/api/auth/callback/okta
# Production origin: https://cpatools.gylxxgroup.com
# Production callback URL: https://cpatools.gylxxgroup.com/api/auth/callback/okta
AUTH_OKTA_ID=
AUTH_OKTA_SECRET=
AUTH_OKTA_ISSUER=https://your-okta-domain.okta.com/oauth2/default
# Use a cryptographically random value of at least 32 bytes.
AUTH_SECRET=
# Use https://cpatools.gylxxgroup.com in the Vercel Production environment.
NEXTAUTH_URL=http://localhost:3000

# Optional: add an AI-written summary to website audit reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional for local audits when Chrome or Edge cannot be auto-detected.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Optional: extra URL fragments treated as intentional archives, comma separated.
# Findings about past dates on matching pages are downgraded one severity level.
AUDIT_ARCHIVE_PATTERNS=
